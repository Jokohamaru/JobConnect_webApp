generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CANDIDATE
  RECRUITER
  ADMIN
}

enum UserStatus {
  ACTIVE
  PENDING
  BANNED
  DELETED
}

enum JobStatus {
  DRAFT
  PENDING_APPROVAL
  PUBLISHED
  CLOSED
}

enum ApplicationStatus {
  APPLIED
  REVIEWING
  ACCEPTED
  REJECTED
}

enum CVStatus {
  DONE
  DRAFT
  DELETED
}

enum CVType {
  UPLOADED
  BUILDER
}

enum Currency {
  VND
  USD
}



model User {
  id            String     @id @default(uuid())
  email         String     @unique
  password      String?    
  firstName     String?    @map("first_name")
  lastName      String?    @map("last_name")
  avaUrl        String?    
  role          UserRole   @default(CANDIDATE)
  status        UserStatus @default(ACTIVE)

  candidate     Candidate?
  recruiter     Recruiter?
  adminProfile  Admin?

  accounts      Account[]
  
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  deletedAt     DateTime?  

  @@map("users")
}

model Account {
  id                String  @id @default(uuid())
  userId            String
  provider          String  
  providerAccountId String
  user              User    @relation(fields: [userId], references: [id])

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Candidate {
  id          String   @id @default(uuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id])
  phoneNumber String?
  careerRole  String?
  dob         String?
  gender      String?
  address     String?
  city        String?
  link        String?

  cvs         CV[]
  savedJobs   SavedJob[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  @@map("candidates")
}

model Recruiter {
  id          String   @id @default(uuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id])
  phoneNumber String?
  
  companyId   String?
  company     Company? @relation(fields: [companyId], references: [id])
  
  jobs        Job[]    // Recruiter đăng bài
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  @@map("recruiters")
}

model Admin {
  id          String   @id @default(uuid())
  userId      String   @unique
  user        User     @relation(fields: [userId], references: [id])
  
  // Phê duyệt Job
  approvedJobs Job[]   @relation("AdminApprover")

  @@map("admins")
}

model Company {
  id            String      @id @default(uuid())
  name          String
  size          String?
  nation        String?
  description   String?     @db.Text
  address       String?
  logoUrl       String?     // Sẽ lưu link AWS S3
  websiteUrl    String?
  
  typeId        String?
  type          CompanyType? @relation(fields: [typeId], references: [id])
  
  recruiters    Recruiter[]
  jobs          Job[]
  
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  deletedAt     DateTime?

  @@map("companies")
}

model CompanyType {
  id        String    @id @default(uuid())
  name      String    @unique
  companies Company[]
  
  @@map("company_types")
}

model Job {
  id                String       @id @default(uuid())
  title             String
  description       String       @db.Text
  headcount         Int          @default(1)

  // Tách biệt lương để lọc dữ liệu
  minSalary         Int?
  maxSalary         Int?
  currency          Currency     @default(VND)
  
  status            JobStatus    @default(DRAFT)
  
  // Phân quyền & Kiểm duyệt
  companyId         String
  company           Company      @relation(fields: [companyId], references: [id])
  recruiterId       String
  recruiter         Recruiter    @relation(fields: [recruiterId], references: [id])
  
  approvedById      String?
  approvedBy        Admin?       @relation("AdminApprover", fields: [approvedById], references: [id])
  approvedAt        DateTime?

  cityId            String
  city              City         @relation(fields: [cityId], references: [id])
  
  tags              Tag[]        @relation("JobTags")
  skills            RequirementSkill[] @relation("JobSkills")
  applications      Application[]
  savedBy           SavedJob[]
  
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt
  deletedAt         DateTime?

  @@map("jobs")
}

model CV {
  id          String      @id @default(uuid())
  title       String
  cvUrl       String      // Link AWS S3 hoặc local path
  cvType      CVType      @default(UPLOADED) // UPLOADED hoặc BUILDER
  cvData      Json?       // Lưu CV builder data (nếu là BUILDER type)
  status      CVStatus    @default(DONE)
  
  candidateId String
  candidate   Candidate   @relation(fields: [candidateId], references: [id])
  
  applications Application[]
  
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt
  deletedAt   DateTime?

  @@map("cvs")
}

model Application {
  id          String            @id @default(uuid())
  status      ApplicationStatus @default(APPLIED)
  
  jobId       String
  job         Job               @relation(fields: [jobId], references: [id])
  
  cvId        String
  cv          CV                @relation(fields: [cvId], references: [id])
  
  appliedAt   DateTime          @default(now())
  deletedAt   DateTime?

  @@map("applications")
}

model SavedJob {
  id          String    @id @default(uuid())
  
  candidateId String
  candidate   Candidate @relation(fields: [candidateId], references: [id])
  
  jobId       String
  job         Job       @relation(fields: [jobId], references: [id])
  
  savedAt     DateTime  @default(now())

  @@unique([candidateId, jobId])
  @@map("saved_jobs")
}

// --- MASTER DATA TABLES ---

model City {
  id    String @id @default(uuid())
  name  String @unique
  jobs  Job[]

  @@map("cities")
}

model Tag {
  id    String @id @default(uuid())
  name  String @unique
  jobs  Job[]  @relation("JobTags")

  @@map("tags")
}

model RequirementSkill {
  id    String @id @default(uuid())
  name  String @unique
  jobs  Job[]  @relation("JobSkills")

  @@map("requirement_skills")
}